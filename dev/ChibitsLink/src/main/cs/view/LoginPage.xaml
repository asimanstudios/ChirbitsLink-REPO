<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ChibitsLink.main.cs.viewmodel"
             x:Class="ChibitsLink.main.cs.view.LoginPage"
             x:DataType="viewmodel:LoginPageViewModel"
             Shell.FlyoutBehavior="Disabled"
             Title="Chibits Link - Login"
             BackgroundColor="{StaticResource Background}">

    <ScrollView Background="{StaticResource BackgroundMesh}">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto" Padding="30" RowSpacing="30" VerticalOptions="Center">
            
            <!-- Dynamic Logo -->
            <VerticalStackLayout Grid.Row="0" Spacing="0" HorizontalOptions="Center" Margin="0,10,0,10">
                <Grid>
                    <Label Text="CHIBITS" 
                           FontSize="64" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}" 
                           HorizontalOptions="Center"
                           Style="{StaticResource ModernTitle}"
                           TranslationX="4" TranslationY="4" Opacity="0.2"/>
                    <Label Text="CHIBITS" 
                           FontSize="64" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}" 
                           HorizontalOptions="Center"
                           Style="{StaticResource ModernTitle}"/>
                </Grid>
                <Label Text="LINK" 
                       FontSize="32" 
                       TextColor="{StaticResource Secondary}" 
                       HorizontalOptions="Center" 
                       CharacterSpacing="15"
                       FontAttributes="Bold"
                       Margin="0,-20,0,0"/>
            </VerticalStackLayout>
     
            <!-- Hero Login Form -->
            <Border Style="{StaticResource HeroCard}" Grid.Row="1" Padding="30">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="40, *">
                        <Label Text="👤" VerticalOptions="Center" FontSize="20" HorizontalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding Username}" 
                               Placeholder="Tu Alias de Héroe" 
                               Style="{StaticResource ModernEntry}"/>
                    </Grid>
                    
                    <BoxView HeightRequest="1.5" Color="{StaticResource BorderColor}" Opacity="0.15" Margin="10,0" />

                    <Grid ColumnDefinitions="40, *">
                        <Label Text="🔑" VerticalOptions="Center" FontSize="20" HorizontalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding Password}" 
                               Placeholder="Palabra Secreta" 
                               IsPassword="True" 
                               Style="{StaticResource ModernEntry}"/>
                    </Grid>
                    
                    <Label Text="¿Has perdido tu llave?" 
                           TextColor="{StaticResource Primary}" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>
     
            <!-- Actions Section -->
            <VerticalStackLayout Grid.Row="2" Spacing="18">
                <Button Text="DESBLOQUEAR REINO" 
                        Style="{StaticResource ModernButton}" 
                        Command="{Binding LoginCommand}" />
                
                <Button Text="UNIRSE A LA AVENTURA" 
                        Style="{StaticResource SecondaryButton}" 
                        Clicked="OnRegisterClicked" />
            </VerticalStackLayout>
    
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}"
                               Grid.Row="3" 
                               Color="{StaticResource Primary}" 
                               HorizontalOptions="Center"
                               HeightRequest="40" WidthRequest="40"/>
        </Grid>
    </ScrollView>
</ContentPage>
