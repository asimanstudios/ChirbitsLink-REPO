<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChibitsLink.main.cs.view.LoginPage"
             Shell.FlyoutBehavior="Disabled"
             Title="Chibits Link - Login"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" Padding="30" RowSpacing="20" VerticalOptions="Center">
            
            <!-- Logo Area -->
            <VerticalStackLayout Grid.Row="0" Spacing="0" HorizontalOptions="Center">
                <Label Text="CHIBITS" 
                       FontSize="48" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource Primary}" 
                       HorizontalOptions="Center"
                       Style="{StaticResource ModernTitle}"/>
                <Label Text="LINK" 
                       FontSize="24" 
                       TextColor="{StaticResource Secondary}" 
                       HorizontalOptions="Center" 
                       CharacterSpacing="10"
                       FontAttributes="Bold"
                       Margin="0,-10,0,0"/>
            </VerticalStackLayout>
    
            <!-- Login Form -->
            <VerticalStackLayout Grid.Row="1" Spacing="12">
                <Entry x:Name="UsernameEntry" 
                       Placeholder="Correo del Aventurero" 
                       Style="{StaticResource ModernEntry}"/>
                <Entry x:Name="PasswordEntry" 
                       Placeholder="Palabra Secreta" 
                       IsPassword="True" 
                       Style="{StaticResource ModernEntry}"/>
                
                <Label Text="¿Olvidaste tu contraseña?" 
                       TextColor="{StaticResource Primary}" 
                       FontSize="12" 
                       HorizontalOptions="End"
                       Margin="0,0,5,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
    
            <!-- Actions -->
            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Button Text="ENTRAR AL REINO" 
                        Style="{StaticResource ModernButton}" 
                        Clicked="OnLoginClicked" />
                
                <Button Text="CREAR NUEVO HÉROE" 
                        Style="{StaticResource SecondaryButton}" 
                        Clicked="OnRegisterClicked" />
            </VerticalStackLayout>
    
            <ActivityIndicator x:Name="LoadingIndicator" 
                               Grid.Row="3" 
                               IsRunning="False" 
                               Color="{StaticResource Primary}" 
                               HorizontalOptions="Center"/>
        </Grid>
    </ScrollView>
</ContentPage>
