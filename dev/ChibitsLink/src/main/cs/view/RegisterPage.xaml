<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ChibitsLink.main.cs.viewmodel"
             x:Class="ChibitsLink.main.cs.view.RegisterPage"
             x:DataType="viewmodel:RegisterPageViewModel"
             Shell.FlyoutBehavior="Disabled"
             Title="Chibits Link - Register"
             BackgroundColor="{StaticResource Background}">

    <ScrollView Background="{StaticResource BackgroundMesh}">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto" Padding="30" RowSpacing="25" VerticalOptions="Center">
            
            <VerticalStackLayout Grid.Row="0" Spacing="5" HorizontalOptions="Center">
                <Label Text="NUEVO HÉROE" 
                       FontSize="42" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource Primary}" 
                       HorizontalOptions="Center"
                       Style="{StaticResource ModernTitle}"/>
                <Label Text="CREA TU LEYENDA" 
                       FontSize="12" 
                       TextColor="{StaticResource Secondary}" 
                       HorizontalOptions="Center"
                       CharacterSpacing="5"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>
    
            <Border Style="{StaticResource HeroCard}" Grid.Row="1" Padding="25">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="40, *">
                        <Label Text="🆔" VerticalOptions="Center" FontSize="18" HorizontalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding RealName}" 
                               Placeholder="Nombre del Héroe" 
                               Style="{StaticResource ModernEntry}"/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="40, *">
                        <Label Text="👤" VerticalOptions="Center" FontSize="18" HorizontalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding Username}" 
                               Placeholder="Alias (@aventurero)" 
                               Style="{StaticResource ModernEntry}"/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="40, *">
                        <Label Text="📧" VerticalOptions="Center" FontSize="18" HorizontalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding Email}" 
                               Placeholder="Correo de Aventurero" 
                               Keyboard="Email"
                               Style="{StaticResource ModernEntry}"/>
                    </Grid>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Opacity="0.15" Margin="10,5" />

                    <Grid ColumnDefinitions="40, *">
                        <Label Text="🔒" VerticalOptions="Center" FontSize="18" HorizontalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding Password}" 
                               Placeholder="Contraseña Secreta" 
                               IsPassword="True" 
                               Style="{StaticResource ModernEntry}"/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="40, *">
                        <Label Text="🔄" VerticalOptions="Center" FontSize="18" HorizontalOptions="Center"/>
                        <Entry Grid.Column="1" Text="{Binding ConfirmPassword}" 
                               Placeholder="Repetir Contraseña" 
                               IsPassword="True" 
                               Style="{StaticResource ModernEntry}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
     
            <Button Grid.Row="2" 
                    Text="FORJAR MI CUENTA" 
                    Style="{StaticResource MedievalButton}" 
                    Command="{Binding RegisterCommand}"
                    Margin="0,10,0,0"/>
    
            <Button Grid.Row="3" 
                    Text="YA SOY UN HÉROE (LOGIN)" 
                    TextColor="{StaticResource Tertiary}"
                    BackgroundColor="Transparent"
                    Clicked="OnBackClicked"
                    FontSize="13"
                    FontAttributes="Bold"/>
        </Grid>
    </ScrollView>
</ContentPage>
