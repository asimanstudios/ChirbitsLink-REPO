<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChibitsLink.main.cs.view.SelectionPage"
             Title="Chibits Link - Setup">

    <ScrollView BackgroundColor="{StaticResource Background}">
        <VerticalStackLayout Padding="30" Spacing="25" BackgroundColor="{StaticResource Background}">
            <Label Text="MODO DE CONEXIÓN" Style="{StaticResource ModernTitle}" TextColor="{StaticResource Secondary}"/>
            
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="QR SCAN" Style="{StaticResource NeonButton}" Clicked="OnQRClicked" HeightRequest="45" Padding="15,0"/>
                <Button Text="BLUETOOTH" Style="{StaticResource NeonButton}" Clicked="OnBluetoothClicked" HeightRequest="45" Padding="15,0"/>
                <Button Text="WEBSOCKET" Style="{StaticResource NeonButton}" Clicked="OnWebSocketClicked" HeightRequest="45" Padding="15,0"/>
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource Surface}" Margin="0,10"/>

            <!-- Lobby Section (R02) -->
            <VerticalStackLayout Spacing="10" Padding="10">
                <Label Text="UNIRSE A SALA" FontSize="18" TextColor="{StaticResource Primary}" HorizontalOptions="Center" FontAttributes="Bold"/>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Entry x:Name="RoomCodeEntry" 
                           Placeholder="CÓDIGO DE 6 DÍGITOS" 
                           MaxLength="6"
                           Keyboard="Numeric"
                           Style="{StaticResource ModernEntry}"/>
                    <Button Grid.Column="1" 
                            Text="UNIRSE" 
                            Style="{StaticResource MedievalButton}" 
                            WidthRequest="100"
                            Clicked="OnJoinLobbyClicked"/>
                </Grid>
            </VerticalStackLayout>

            <Label Text="O ELIGE UN JUEGO" FontSize="16" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" FontAttributes="Bold"/>

            <CollectionView x:Name="GamesCollection" SelectionMode="Single" SelectionChanged="OnGameSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5" Style="{StaticResource GlassFrame}" Stroke="{StaticResource Tertiary}">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextMain}"/>
                                <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource TextLight}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="StartButton" 
                    Text="ENTRAR AL MANDO" 
                    IsEnabled="False"
                    Style="{StaticResource ModernButton}" 
                    Clicked="OnStartClicked"
                    HeightRequest="60"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
