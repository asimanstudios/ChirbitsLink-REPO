<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChibitsLink.main.cs.view.SettingsPage"
             Title="Ajustes del Héroe"
             BackgroundColor="{StaticResource Background}">
    
    <ScrollView Background="{StaticResource BackgroundMesh}">
        <VerticalStackLayout Spacing="30" Padding="25">
            <!-- Header Section -->
            <VerticalStackLayout Spacing="5" Margin="0,10">
                <Label Text="AJUSTES DEL HÉROE"
                       Style="{StaticResource ModernTitle}" />
                <Label Text="Configura tu identidad y conexión mágica"
                       FontSize="14"
                       TextColor="{StaticResource TextLight}"
                       Opacity="0.8"/>
            </VerticalStackLayout>
            
            <!-- Profile Section -->
            <Label Text="DATOS PERSONALES" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" CharacterSpacing="1.5" />
            <Border Style="{StaticResource HeroCard}">
                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nombre Real" FontSize="13" TextColor="{StaticResource TextLight}" Margin="5,0" />
                        <Grid ColumnDefinitions="40, *">
                            <Label Text="🆔" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
                            <Entry Grid.Column="1" x:Name="RealNameEntry" Placeholder="Tu nombre" Style="{StaticResource ModernEntry}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nombre de Usuario" FontSize="13" TextColor="{StaticResource TextLight}" Margin="5,0" />
                        <Grid ColumnDefinitions="40, *">
                            <Label Text="👤" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
                            <Entry Grid.Column="1" x:Name="UsernameEntry" Placeholder="@alias" Style="{StaticResource ModernEntry}" />
                        </Grid>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Correo Mágico" FontSize="13" TextColor="{StaticResource TextLight}" Margin="5,0" />
                        <Grid ColumnDefinitions="40, *">
                            <Label Text="📧" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
                            <Entry Grid.Column="1" x:Name="EmailEntry" Placeholder="correo@ejemplo.com" Keyboard="Email" Style="{StaticResource ModernEntry}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Security Section -->
            <Label Text="SEGURIDAD" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" CharacterSpacing="1.5" />
            <Border Style="{StaticResource GlassFrame}">
                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña Actual" FontSize="13" TextColor="{StaticResource TextLight}" Margin="5,0" />
                        <Grid ColumnDefinitions="40, *">
                            <Label Text="🔑" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
                            <Entry Grid.Column="1" x:Name="CurrentPasswordEntry" Placeholder="Tu contraseña actual" IsPassword="True" Style="{StaticResource ModernEntry}" />
                        </Grid>
                        <Label Text="Necesaria para cambiar contraseña o email"
                               FontSize="11" TextColor="{StaticResource TextLight}" Opacity="0.6" Margin="45,0,0,0"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nueva Contraseña" FontSize="13" TextColor="{StaticResource TextLight}" Margin="5,0" />
                        <Grid ColumnDefinitions="40, *">
                            <Label Text="🔒" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
                            <Entry Grid.Column="1" x:Name="NewPasswordEntry" Placeholder="••••••••" IsPassword="True" Style="{StaticResource ModernEntry}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Confirmar Contraseña" FontSize="13" TextColor="{StaticResource TextLight}" Margin="5,0" />
                        <Grid ColumnDefinitions="40, *">
                            <Label Text="🔄" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
                            <Entry Grid.Column="1" x:Name="ConfirmNewPasswordEntry" Placeholder="••••••••" IsPassword="True" Style="{StaticResource ModernEntry}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Networking Section -->
            <Label Text="CONEXIÓN CON UNITY" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" CharacterSpacing="1.5" />
            <Border Style="{StaticResource GlassFrame}">
                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="IP del Servidor" FontSize="13" TextColor="{StaticResource TextLight}" Margin="5,0" />
                        <Grid ColumnDefinitions="40, *">
                            <Label Text="🌐" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
                            <Entry Grid.Column="1" x:Name="ServerIpEntry" Placeholder="127.0.0.1" Style="{StaticResource ModernEntry}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Puerto" FontSize="13" TextColor="{StaticResource TextLight}" Margin="5,0" />
                        <Grid ColumnDefinitions="40, *">
                            <Label Text="🔌" VerticalOptions="Center" HorizontalOptions="Center" FontSize="18"/>
                            <Entry Grid.Column="1" x:Name="ServerPortEntry" Placeholder="11000" Keyboard="Numeric" Style="{StaticResource ModernEntry}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <VerticalStackLayout Spacing="15" Margin="0,10,0,30">
                <Button Text="GUARDAR CAMBIOS" Style="{StaticResource ModernButton}" Clicked="OnSaveClicked" />
                <Button Text="CANCELAR" Style="{StaticResource SecondaryButton}" Clicked="OnBackClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
