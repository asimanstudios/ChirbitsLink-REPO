<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChibitsLink.main.cs.view.SettingsPage"
             Title="Ajustes del Héroe"
             BackgroundColor="{StaticResource Background}">
    
    <ScrollView Padding="25">
        <VerticalStackLayout Spacing="25">
            <!-- Header Section -->
            <VerticalStackLayout Spacing="5">
                <Label Text="PERFIL DEL AVENTURERO"
                       Style="{StaticResource ModernTitle}" />
                <Label Text="Gestiona tus datos sagrados"
                       FontSize="13"
                       TextColor="{StaticResource TextLight}"
                       HorizontalOptions="Center"
                       CharacterSpacing="1"/>
            </VerticalStackLayout>
            
            <!-- Profile Form -->
            <Border Style="{StaticResource GlassFrame}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Nombre Real" 
                           FontSize="14" 
                           TextColor="{StaticResource Secondary}" 
                           FontAttributes="Bold" />
                    <Entry x:Name="RealNameEntry" 
                           Placeholder="Tu nombre mortal"
                           Style="{StaticResource ModernEntry}" />

                    <Label Text="Nombre de Usuario" 
                           FontSize="14" 
                           TextColor="{StaticResource Secondary}" 
                           FontAttributes="Bold" />
                    <Entry x:Name="UsernameEntry" 
                           Placeholder="@hero"
                           Style="{StaticResource ModernEntry}" />
                    
                    <Label Text="Correo Mágico" 
                           FontSize="14" 
                           TextColor="{StaticResource Secondary}" 
                           FontAttributes="Bold" />
                    <Entry x:Name="EmailEntry" 
                           Placeholder="tu@correo.com"
                           Keyboard="Email"
                           Style="{StaticResource ModernEntry}" />
                </VerticalStackLayout>
            </Border>

            <!-- Security Section -->
            <Label Text="SEGURIDAD"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Tertiary}" 
                   CharacterSpacing="1"/>
            
            <Border Style="{StaticResource GlassFrame}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Nueva Contraseña" 
                           FontSize="14" 
                           TextColor="{StaticResource Secondary}" 
                           FontAttributes="Bold" />
                    <Entry x:Name="NewPasswordEntry" 
                           Placeholder="Dejar en blanco para no cambiar"
                           IsPassword="True"
                           Style="{StaticResource ModernEntry}" />
                </VerticalStackLayout>
            </Border>

            <!-- Preferences Section -->
            <Label Text="PREFERENCIAS"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Tertiary}"
                   CharacterSpacing="1"/>
            
            <Border Style="{StaticResource GlassFrame}">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Mantener Sesión (30 días)" VerticalOptions="Center" TextColor="{StaticResource TextMain}" />
                        <Switch x:Name="PersistenceSwitch" Grid.Column="1" IsToggled="True" OnColor="{StaticResource Secondary}" />
                    </Grid>
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Vibración en Mando" VerticalOptions="Center" TextColor="{StaticResource TextMain}" />
                        <Switch IsToggled="True" Grid.Column="1" OnColor="{StaticResource Secondary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Networking Section -->
            <Label Text="CONFIGURACIÓN DE RED"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Tertiary}"
                   CharacterSpacing="1"/>

            <Border Style="{StaticResource GlassFrame}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Dirección IP del Juego" 
                           FontSize="14" 
                           TextColor="{StaticResource Secondary}" 
                           FontAttributes="Bold" />
                    <Entry x:Name="ServerIpEntry" 
                           Placeholder="localhost o 127.0.0.1"
                           Style="{StaticResource ModernEntry}" />

                    <Label Text="Puerto del Servidor" 
                           FontSize="14" 
                           TextColor="{StaticResource Secondary}" 
                           FontAttributes="Bold" />
                    <Entry x:Name="ServerPortEntry" 
                           Placeholder="11000"
                           Keyboard="Numeric"
                           Style="{StaticResource ModernEntry}" />
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                <Button Text="GUARDAR CAMBIOS"
                        Style="{StaticResource ModernButton}"
                        Clicked="OnSaveClicked" />
                
                <Button Text="VOLVER"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnBackClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
