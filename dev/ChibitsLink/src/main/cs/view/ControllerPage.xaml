<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChibitsLink.main.cs.view.ControllerPage"
             Title="Chibits Controller"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *" Padding="20">
        
        <!-- Header Overlay (Tilt & Latency) -->
        <HorizontalStackLayout Grid.Row="0" Spacing="20" HorizontalOptions="Center" VerticalOptions="Start" Padding="10">
            <Button Text="VOLVER" 
                    Clicked="OnBackClicked" 
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="40"
                    FontSize="12"/>
            <Label Text="MODO TILT" VerticalOptions="Center" TextColor="{StaticResource Secondary}" FontAttributes="Bold"/>
            <Switch x:Name="TiltSwitch" Toggled="OnTiltToggled" OnColor="{StaticResource Secondary}" ThumbColor="{StaticResource Background}"/>
            <Label x:Name="LatencyLabel" Text="Ping: 0ms" VerticalOptions="Center" TextColor="{StaticResource Tertiary}" FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            
            <!-- Joystick Area (Left) -->
            <ContentView Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                <AbsoluteLayout x:Name="JoystickBoundary" 
                                WidthRequest="200" 
                                HeightRequest="200">
                    <Ellipse Fill="#20000000" 
                             Stroke="{StaticResource Tertiary}" 
                             StrokeThickness="3" 
                             WidthRequest="200" 
                             HeightRequest="200"/>
                    
                    <Ellipse x:Name="JoystickKnob"
                             Fill="{StaticResource Primary}" 
                             WidthRequest="80" 
                             HeightRequest="80"
                             Stroke="{StaticResource Secondary}"
                             StrokeThickness="3"
                             AbsoluteLayout.LayoutBounds="60, 60, 80, 80">
                        <Ellipse.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnJoystickPanUpdated" />
                        </Ellipse.GestureRecognizers>
                    </Ellipse>
                </AbsoluteLayout>
            </ContentView>

            <!-- Buttons Area (Right) -->
            <Grid Grid.Column="1" 
                   RowDefinitions="*, *, *" 
                   ColumnDefinitions="*, *, *" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   WidthRequest="240"
                   HeightRequest="240">
                
                <Button Grid.Row="0" Grid.Column="1" Text="Y" Style="{StaticResource ModernButton}" Clicked="OnButtonClicked" CommandParameter="Y" BackgroundColor="#FDCB6E" />
                <Button Grid.Row="1" Grid.Column="0" Text="X" Style="{StaticResource ModernButton}" Clicked="OnButtonClicked" CommandParameter="X" BackgroundColor="{StaticResource Tertiary}" />
                <Button Grid.Row="1" Grid.Column="2" Text="B" Style="{StaticResource ModernButton}" Clicked="OnButtonClicked" CommandParameter="B" BackgroundColor="{StaticResource Secondary}" />
                <Button Grid.Row="2" Grid.Column="1" Text="A" Style="{StaticResource ModernButton}" Clicked="OnButtonClicked" CommandParameter="A" BackgroundColor="{StaticResource Success}" />
            </Grid>
        </Grid>

        <!-- Connection Status -->
        <HorizontalStackLayout Grid.Row="1" 
                               HorizontalOptions="Center" 
                               VerticalOptions="End" 
                               Spacing="10" 
                               Margin="0,0,0,10">
            <Ellipse Fill="{StaticResource Success}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"/>
            <Label Text="VINCULADO AL REINO" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMain}"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
