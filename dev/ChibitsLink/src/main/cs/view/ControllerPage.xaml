<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChibitsLink.main.cs.view.ControllerPage"
             Title="Chibits Controller"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *" Padding="20">
        
        <!-- Header Overlay (Tilt & Latency) -->
        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="20" HorizontalOptions="Center" VerticalOptions="Start" Padding="10">
            <Label Text="MODO TILT" VerticalOptions="Center" TextColor="{StaticResource Tertiary}" FontAttributes="Bold"/>
            <Switch x:Name="TiltSwitch" Toggled="OnTiltToggled" ThumbColor="{StaticResource Secondary}" OnColor="{StaticResource Primary}" />
            <Label x:Name="LatencyLabel" Text="Ping: 0ms" VerticalOptions="Center" TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            
            <!-- Joystick Area (Left) -->
            <ContentView Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                <AbsoluteLayout x:Name="JoystickBoundary" 
                                WidthRequest="200" 
                                HeightRequest="200" 
                                BackgroundColor="#225D4037">
                    <Ellipse Fill="Transparent" 
                             Stroke="{StaticResource Primary}" 
                             StrokeThickness="4" 
                             WidthRequest="200" 
                             HeightRequest="200"/>
                    
                    <Ellipse x:Name="JoystickKnob"
                             Fill="{StaticResource Secondary}" 
                             WidthRequest="80" 
                             HeightRequest="80"
                             Stroke="{StaticResource Primary}"
                             StrokeThickness="2"
                             AbsoluteLayout.LayoutBounds="60, 60, 80, 80">
                        <Ellipse.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnJoystickPanUpdated" />
                        </Ellipse.GestureRecognizers>
                    </Ellipse>
                </AbsoluteLayout>
            </ContentView>

            <!-- Buttons Area (Right) -->
            <Grid Grid.Column="1" 
                  RowDefinitions="*, *, *" 
                  ColumnDefinitions="*, *, *" 
                  VerticalOptions="Center" 
                  HorizontalOptions="Center"
                  WidthRequest="250"
                  HeightRequest="250">
                
                <Button Grid.Row="0" Grid.Column="1" Text="Y" Style="{StaticResource MedievalButton}" Clicked="OnButtonClicked" CommandParameter="Y" BackgroundColor="#E5C100" />
                <Button Grid.Row="1" Grid.Column="0" Text="X" Style="{StaticResource MedievalButton}" Clicked="OnButtonClicked" CommandParameter="X" BackgroundColor="#2196F3" />
                <Button Grid.Row="1" Grid.Column="2" Text="B" Style="{StaticResource MedievalButton}" Clicked="OnButtonClicked" CommandParameter="B" BackgroundColor="#F44336" />
                <Button Grid.Row="2" Grid.Column="1" Text="A" Style="{StaticResource MedievalButton}" Clicked="OnButtonClicked" CommandParameter="A" BackgroundColor="#4CAF50" />
            </Grid>
        </Grid>

        <!-- Connection Status -->
        <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" 
                               HorizontalOptions="Center" 
                               VerticalOptions="End" 
                               Spacing="10" 
                               Margin="0,0,0,10">
            <Ellipse Fill="#4CAF50" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
            <Label Text="VINCULADO AL REINO" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
