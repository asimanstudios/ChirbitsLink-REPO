<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChibitsLink.main.cs.view.ControllerPage"
             Title="Chibits Controller"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *" Padding="20">
        
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15" BackgroundColor="{StaticResource Surface}">
            <Button Grid.Column="0" 
                    Text="VOLVER" 
                    Clicked="OnBackClicked" 
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="44"
                    FontSize="12"
                    CornerRadius="22"/>
            
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label x:Name="UsernameLabel" 
                       Text="USUARIO" 
                       TextColor="{StaticResource TextMain}" 
                       FontAttributes="Bold" 
                       CharacterSpacing="1"
                       FontSize="16"
                       HorizontalOptions="Center"/>
                <Label x:Name="UserLevelLabel" 
                       Text="LVL. 1" 
                       TextColor="{StaticResource Accent}" 
                       FontAttributes="Bold" 
                       FontSize="12"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
            
            <HorizontalStackLayout Grid.Column="2" Spacing="15" VerticalOptions="Center">
                <Label Text="TILT" VerticalOptions="Center" TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="12"/>
                <Switch x:Name="TiltSwitch" Toggled="OnTiltToggled" OnColor="{StaticResource Primary}" ThumbColor="{StaticResource Background}" Scale="0.8"/>
                <Label x:Name="LatencyLabel" Text="0ms" VerticalOptions="Center" TextColor="{StaticResource Secondary}" FontAttributes="Bold" FontSize="12"/>
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            
            
            <ContentView Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                <AbsoluteLayout x:Name="JoystickBoundary" 
                                WidthRequest="220" 
                                HeightRequest="220">
                    <Ellipse Fill="#10000000" 
                             Stroke="{StaticResource BorderColor}" 
                             StrokeThickness="4" 
                             WidthRequest="220" 
                             HeightRequest="220"/>
                    
                    <Ellipse x:Name="JoystickKnob"
                             Fill="{StaticResource Primary}" 
                             WidthRequest="90" 
                             HeightRequest="90"
                             Stroke="{StaticResource BorderColor}"
                             StrokeThickness="3"
                             AbsoluteLayout.LayoutBounds="65, 65, 90, 90">
                        <Ellipse.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnJoystickPanUpdated" />
                        </Ellipse.GestureRecognizers>
                    </Ellipse>
                </AbsoluteLayout>
            </ContentView>

            
            <Grid Grid.Column="1" 
                   RowDefinitions="*, *, *" 
                   ColumnDefinitions="*, *, *" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   WidthRequest="240"
                   HeightRequest="240">
                
                <Button Grid.Row="0" Grid.Column="1" Text="Y" Style="{StaticResource ModernButton}" Clicked="OnButtonClicked" CommandParameter="Y" BackgroundColor="#FFCE5C" TextColor="{StaticResource TextMain}" CornerRadius="35" WidthRequest="70" HeightRequest="70" Padding="0"/>
                <Button Grid.Row="1" Grid.Column="0" Text="X" Style="{StaticResource ModernButton}" Clicked="OnButtonClicked" CommandParameter="X" BackgroundColor="{StaticResource Secondary}" TextColor="{StaticResource TextMain}" CornerRadius="35" WidthRequest="70" HeightRequest="70" Padding="0"/>
                <Button Grid.Row="1" Grid.Column="2" Text="B" Style="{StaticResource ModernButton}" Clicked="OnButtonClicked" CommandParameter="B" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="35" WidthRequest="70" HeightRequest="70" Padding="0"/>
                <Button Grid.Row="2" Grid.Column="1" Text="A" Style="{StaticResource ModernButton}" Clicked="OnButtonClicked" CommandParameter="A" BackgroundColor="#00D2D3" TextColor="White" CornerRadius="35" WidthRequest="70" HeightRequest="70" Padding="0"/>
            </Grid>
        </Grid>

        
        <HorizontalStackLayout Grid.Row="1" 
                               HorizontalOptions="Center" 
                               VerticalOptions="End" 
                               Spacing="10" 
                               Margin="0,0,0,10">
            <Ellipse Fill="{StaticResource Success}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"/>
            <Label Text="VINCULADO AL REINO" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMain}"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
