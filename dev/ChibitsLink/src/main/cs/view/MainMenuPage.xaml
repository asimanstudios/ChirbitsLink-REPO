<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:ChibitsLink.main.cs.model"
             x:Class="ChibitsLink.main.cs.view.MainMenuPage"
             Title="Chibits Hub"
             BackgroundColor="{StaticResource Background}">
    
    <Grid RowDefinitions="Auto, *, Auto" Padding="25" RowSpacing="20">
        
        <!-- Header & Profile -->
            <VerticalStackLayout Grid.Row="0" Spacing="15" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </VerticalStackLayout.GestureRecognizers>
                
                <!-- Circular Profile Image (Sticker Style) -->
                <Border WidthRequest="120" 
                        HeightRequest="120" 
                        Padding="0" 
                        HorizontalOptions="Center"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="4">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Image x:Name="ProfileImage" 
                           Source="char_placeholder" 
                           Aspect="AspectFill" 
                           BackgroundColor="{StaticResource Surface}"/>
                </Border>
            
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" InputTransparent="True">
                <Label x:Name="UsernameLabel"
                       Text=""
                       FontAttributes="Bold"
                       FontSize="22"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource TextMain}"
                       CharacterSpacing="2"
                       InputTransparent="True"/>
                
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" InputTransparent="True">
                    <Label x:Name="UserLevelLabel" 
                           Text="LVL. 1" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Tertiary}"
                           InputTransparent="True"/>
                    <Label x:Name="CharacterNameLabel"
                           Text="VALIENTE"
                           FontSize="14"
                           TextColor="{StaticResource Secondary}"
                           HorizontalOptions="Center"
                           Opacity="0.8"
                           InputTransparent="True"/>
                </HorizontalStackLayout>
                
                <Label Text="TOCA PARA CAMBIAR"
                       FontSize="11"
                       TextColor="{StaticResource Tertiary}"
                       HorizontalOptions="Center"
                       Opacity="0.8"
                       FontAttributes="Bold"
                       InputTransparent="True"/>
            </VerticalStackLayout>
        </VerticalStackLayout>


        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">
                
                <!-- Character Selection (Hidden by default) -->
                <VerticalStackLayout x:Name="CharacterSelectionLayout" IsVisible="False" Spacing="10">
                    <Label Text="CAMBIAR PERSONAJE" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Secondary}"
                           HorizontalOptions="Center" />
                    
                    <CollectionView x:Name="CharactersCollection"
                                    SelectionMode="None"
                                    HeightRequest="200">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Character">
                                <Border Padding="5" 
                                        Stroke="{StaticResource BorderColor}" 
                                        StrokeThickness="3"
                                        BackgroundColor="{StaticResource Surface}"
                                        WidthRequest="130"
                                        HeightRequest="190">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="24" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCharacterSelected" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="5" InputTransparent="True">
                                        <Image Source="{Binding ImageUrl}" 
                                               HeightRequest="100" 
                                               WidthRequest="100" 
                                               Aspect="AspectFit"
                                               InputTransparent="True" />
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Bold" 
                                               HorizontalOptions="Center" 
                                               FontSize="14" 
                                               TextColor="{StaticResource TextMain}"
                                               InputTransparent="True" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Action Cards -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <Border x:Name="MandoPreviewCard" Grid.Column="0" Style="{StaticResource GlassFrame}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnControllerClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="🎮" FontSize="32" HorizontalOptions="Center" InputTransparent="True"/>
                            <Label Text="MANDO" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource TextMain}" InputTransparent="True"/>
                            <Label Text="Ver diseño" FontSize="10" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" InputTransparent="True"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="HistoryCard" Grid.Column="1" Style="{StaticResource GlassFrame}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoryClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center" InputTransparent="True">
                            <Label Text="📜" FontSize="32" HorizontalOptions="Center" InputTransparent="True"/>
                            <Label Text="HISTORIAL" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource TextMain}" InputTransparent="True"/>
                            <Label Text="Tus aventuras" FontSize="10" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" InputTransparent="True"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Description Card -->
                <Border Style="{StaticResource GlassFrame}" Padding="20" BackgroundColor="{StaticResource Surface}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Sobre ChirBits Link" 
                               FontAttributes="Bold" 
                               FontSize="20" 
                               TextColor="{StaticResource Primary}"/>
                        <Label Text="Esta aplicación convierte tu dispositivo móvil en un mando mágico para interactuar con el mundo de ChirBits. Únete a partidas en Unity, elige tu héroe y prepárate para la aventura." 
                               FontSize="14" 
                               TextColor="{StaticResource TextLight}" 
                               LineHeight="1.5"/>
                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" VerticalOptions="End">
            <Button Text="CONECTAR A PARTIDA" 
                    Style="{StaticResource ModernButton}" 
                    Clicked="OnJoinRoomClicked" />
            
            <Button Text="CONFIGURAR PERFIL" 
                    Style="{StaticResource SecondaryButton}" 
                    Clicked="OnProfileClicked" />
            
            <VerticalStackLayout HorizontalOptions="Center" Padding="20,10">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutClicked" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="Cerrar Sesión" 
                       TextColor="{StaticResource Secondary}" 
                       FontSize="14" 
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
