<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:ChibitsLink.main.cs.model"
             x:Class="ChibitsLink.main.cs.view.MainMenuPage"
             Title="Chibits Hub"
             BackgroundColor="{StaticResource Background}">
    
    <Grid RowDefinitions="Auto, *, Auto" Padding="25" RowSpacing="20">
        
        <!-- Header & Profile -->
        <VerticalStackLayout Grid.Row="0" Spacing="15" HorizontalOptions="Center">
            
            <!-- Circular Profile Image -->
            <Frame WidthRequest="110" 
                   HeightRequest="110" 
                   CornerRadius="55" 
                   Padding="0" 
                   IsClippedToBounds="True" 
                   HorizontalOptions="Center"
                   BorderColor="{StaticResource Primary}"
                   HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Frame.GestureRecognizers>
                <Image x:Name="ProfileImage" 
                       Source="dotnet_bot.png" 
                       Aspect="AspectFill" 
                       BackgroundColor="{StaticResource Background}"/>
            </Frame>
            
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                <Label x:Name="UsernameLabel"
                       Text=""
                       FontAttributes="Bold"
                       FontSize="22"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource TextMain}"
                       CharacterSpacing="2"/>
                <Label x:Name="CharacterNameLabel"
                       Text="VALIENTE"
                       FontSize="14"
                       TextColor="{StaticResource Secondary}"
                       HorizontalOptions="Center"
                       Opacity="0.8"/>
                <Label Text="TOCA PARA CAMBIAR"
                       FontSize="11"
                       TextColor="{StaticResource Tertiary}"
                       HorizontalOptions="Center"
                       Opacity="0.8"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>
        </VerticalStackLayout>


        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">
                
                <!-- Character Selection (Hidden by default) -->
                <VerticalStackLayout x:Name="CharacterSelectionLayout" IsVisible="False" Spacing="10">
                    <Label Text="CAMBIAR PERSONAJE" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Secondary}"
                           HorizontalOptions="Center" />
                    
                    <CollectionView x:Name="CharactersCollection"
                                    SelectionMode="Single"
                                    SelectionChanged="OnCharacterSelected"
                                    HeightRequest="200">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Character">
                                <Frame Padding="5" 
                                       CornerRadius="16" 
                                       HasShadow="False" 
                                       BorderColor="{StaticResource Primary}" 
                                       BackgroundColor="{StaticResource Surface}"
                                       WidthRequest="120"
                                       HeightRequest="180">
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                                        <Image Source="{Binding ImageUrl}" 
                                               HeightRequest="100" 
                                               WidthRequest="100" 
                                               Aspect="AspectFit" />
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Bold" 
                                               HorizontalOptions="Center" 
                                               FontSize="14" 
                                               TextColor="{StaticResource TextMain}" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Action Cards -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <Frame x:Name="MandoPreviewCard" Grid.Column="0" Style="{StaticResource GlassFrame}" Padding="15">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnControllerClicked" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="🎮" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="MANDO" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource TextMain}"/>
                            <Label Text="Ver diseño" FontSize="10" TextColor="{StaticResource TextLight}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame x:Name="HistoryCard" Grid.Column="1" Style="{StaticResource GlassFrame}" Padding="15">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoryClicked" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="📜" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="HISTORIAL" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource TextMain}"/>
                            <Label Text="Tus aventuras" FontSize="10" TextColor="{StaticResource TextLight}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Description Card -->
                <Frame Style="{StaticResource GlassFrame}" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Sobre ChirBits Link" 
                               FontAttributes="Bold" 
                               FontSize="18" 
                               TextColor="{StaticResource Tertiary}"/>
                        <Label Text="Esta aplicación convierte tu dispositivo móvil en un mando mágico para interactuar con el mundo de ChirBits. Únete a partidas en Unity, elige tu héroe y prepárate para la aventura." 
                               FontSize="14" 
                               TextColor="{StaticResource TextLight}" 
                               LineHeight="1.4"/>
                    </VerticalStackLayout>
                </Frame>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" VerticalOptions="End">
            <Button Text="CONECTAR A PARTIDA" 
                    Style="{StaticResource ModernButton}" 
                    Clicked="OnJoinRoomClicked" />
            
            <Button Text="CONFIGURAR PERFIL" 
                    Style="{StaticResource SecondaryButton}" 
                    Clicked="OnProfileClicked" />
            
            <Label Text="Cerrar Sesión" 
                   TextColor="{StaticResource Secondary}" 
                   FontSize="14" 
                   HorizontalOptions="Center"
                   Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutClicked" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
