<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ChibitsLink"
             x:Class="ChibitsLink.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ChirBits Adventure Palette (Vibrant & Cozy) -->
            <Color x:Key="Primary">#FF9200</Color>      <!-- ChirBits Orange -->
            <Color x:Key="Secondary">#48DBFB</Color>    <!-- ChirBits Magic Cyan -->
            <Color x:Key="Tertiary">#FFCE5C</Color>     <!-- ChirBits Sunny Yellow -->
            <Color x:Key="Accent">#A044FF</Color>       <!-- Bird Purple -->
            <Color x:Key="Background">#FFFDF0</Color>   <!-- Soft Cream (Light Mode) -->
            <Color x:Key="Surface">#FFFFFF</Color>      <!-- Paper White -->
            <Color x:Key="TextMain">#432C52</Color>     <!-- Deep Plum (High Contrast) -->
            <Color x:Key="TextLight">#7B608D</Color>    <!-- Soft Plum -->
            <Color x:Key="Success">#00D2D3</Color>      <!-- Jade Green -->
            <Color x:Key="BorderColor">#432C52</Color>  <!-- Thick Outline Color -->
            
            <!-- Default Colors for Legacy Support -->
            <Color x:Key="DefaultPrimaryColor">#FF9200</Color>
            <Color x:Key="DefaultSecondaryColor">#48DBFB</Color>

            <!-- Playful & Premium Styles -->
            <Style x:Key="ModernLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
                <Setter Property="FontFamily" Value="FredokaRegular" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style x:Key="ModernTitle" TargetType="Label" BasedOn="{StaticResource ModernLabel}">
                <Setter Property="FontFamily" Value="FredokaBold" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="CharacterSpacing" Value="1" />
            </Style>

            <Style x:Key="ModernButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="HeightRequest" Value="60" />
                <Setter Property="Padding" Value="24,0" />
                <Setter Property="BorderWidth" Value="3" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.95" />
                                    <Setter Property="BackgroundColor" Value="#E68400" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
            </Style>

            <Style x:Key="ModernEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,8" />
            </Style>

            <Style x:Key="GlassFrame" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="StrokeShape">
                    <RoundRectangle CornerRadius="28" />
                </Setter>
                <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                <Setter Property="StrokeThickness" Value="3" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="Shadow">
                    <Shadow Brush="Black" Offset="5,5" Radius="10" Opacity="0.1" />
                </Setter>
            </Style>

            <!-- Specialty Buttons -->
            <Style x:Key="MedievalButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource Tertiary}" />
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
            </Style>

            <Style x:Key="NeonButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
            </Style>

            <!-- Compatibility Aliases -->
            <Style x:Key="PremiumLabel" TargetType="Label" BasedOn="{StaticResource ModernTitle}" />
            <Style x:Key="BouncyButton" TargetType="Button" BasedOn="{StaticResource ModernButton}" />
            <Style x:Key="VibrantEntry" TargetType="Entry" BasedOn="{StaticResource ModernEntry}" />
            <Style x:Key="ParchmentEntry" TargetType="Entry" BasedOn="{StaticResource ModernEntry}" />
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
